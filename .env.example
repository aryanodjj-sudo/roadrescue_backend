PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/roadrescue?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Optional — used only by `npm run seed`. If unset, falls back to a known
# dev default (admin123) — always set these for a production seed run.
ADMIN_EMAIL=admin@roadrescue.example
ADMIN_PASSWORD=replace_with_a_strong_password
